# ===========================================
# Google OAuth 設定
# 去 https://console.cloud.google.com/apis/credentials 建立
# ===========================================
GOOGLE_CLIENT_ID=你的ClientID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=你的ClientSecret

# ===========================================
# NextAuth 設定
# ===========================================
# 開發環境用這個
NEXTAUTH_URL=http://localhost:3000

# 正式環境改成你的網域，例如：
# NEXTAUTH_URL=https://your-domain.com

# Secret（可以用 openssl rand -base64 32 生成）
# 下面已經幫你生成好一串，直接複製用都可以
AUTH_SECRET=TUEarrxhgvzzG/loUa8lPPJVZdEB5pcFT8ED9p1M1M4=
NEXTAUTH_SECRET=TUEarrxhgvzzG/loUa8lPPJVZdEB5pcFT8ED9p1M1M4=
